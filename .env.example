# Optional, non-secret settings. Copy to .env to change them; every value has a default.
# There are NO passwords here and nowhere else on disk:
#   * root logs in only through the container's Unix socket (docker exec / make shell),
#   * the demo accounts get their passwords from "make set-password" (typed by you)
#     or, during make demo / make test, random ones that live only in memory.

# Host port for MariaDB. The server only listens on 127.0.0.1.
# MARIADB_PORT=3306

# Name of the Docker container (change it to run two copies of the project side by side,
# together with MARIADB_PORT and: COMPOSE_PROJECT_NAME=some_other_name).
# MARIADB_CONTAINER=university-db

# Server image. The default is the exact 13.1.2 build this project was verified with.
# To try the newest 13.1 preview build instead:
# MARIADB_IMAGE=quay.io/mariadb-foundation/mariadb-devel:13.1
