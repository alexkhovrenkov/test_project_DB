# Copy this file to .env (cp .env.example .env) and change the passwords.
# .env is listed in .gitignore, so your real passwords are never committed.

# The MariaDB superuser. Only used for setup and for the admin demo.
MARIADB_ROOT_PASSWORD=change-me-root

# One password per demo user (see sql/04_users.sh).
STUDENT_PASSWORD=change-me-student
PROFESSOR_PASSWORD=change-me-professor
FINANCE_PASSWORD=change-me-finance
ADMIN_PASSWORD=change-me-admin
