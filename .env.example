# You normally do NOT need this file: "make env" (scripts/init_env.sh) creates
# .env with random passwords for you. It documents the variables that exist.
#
# .env is listed in .gitignore, so real passwords are never committed.
# Use only letters, digits, - and _ (sql/04_users.sh rejects anything else),
# at least 12 characters, and not the "change-me" placeholders below.

# The MariaDB superuser. Used for setup, the tests and the admin demos.
MARIADB_ROOT_PASSWORD=change-me-root

# One password per demo user (see sql/04_users.sh).
STUDENT_PASSWORD=change-me-student
PROFESSOR_PASSWORD=change-me-professor
FINANCE_PASSWORD=change-me-finance
ADMIN_PASSWORD=change-me-admin

# Optional overrides
# MARIADB_PORT=3306                 # host port (the server only listens on 127.0.0.1)
# MARIADB_IMAGE=quay.io/mariadb-foundation/mariadb-devel:13.1
